# ==============================================================================
# GreenPulse Agriculture Platform — Backend Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in the values for your environment.
# Never commit the actual '.env' file with real secrets to version control.
# ==============================================================================

# ── 1. Database (MongoDB Atlas) ────────────────────────────────────────────────
# Get your connection string from MongoDB Atlas: Database -> Connect -> Drivers (Python)
# Example: mongodb+srv://greenpulse_app:<password>@cluster0.abcde.mongodb.net/greenpulse?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/greenpulse?retryWrites=true&w=majority
DB_NAME=greenpulse

# ── 2. Security & JWT Authentication ──────────────────────────────────────────
# Generate a cryptographically secure 64-char key using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_character_hex_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 3. Cloudinary Image Storage ───────────────────────────────────────────────
# Get credentials from your Cloudinary Dashboard: https://console.cloudinary.com/
# If left as placeholders, backend uses high-speed inline data-URI fallback for local testing.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 4. App & CORS Configuration ────────────────────────────────────────────────
APP_NAME=GreenPulse
# Comma-separated list of allowed origins. Supports local dev and production domains.
# Wildcard matching *.vercel.app is also automatically supported by CORS middleware.
FRONTEND_URL=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://greenpulse.vercel.app

# ── 5. Initial Super-Admin Seed Credentials ────────────────────────────────────
# Auto-created on first server boot if no admin account exists.
# Public registration CANNOT create admin accounts (strictly locked to 'farmer').
ADMIN_EMAIL=admin@greenpulse.in
ADMIN_PASSWORD=Admin@123456

# ── 6. Business & Support Contact ─────────────────────────────────────────────
WHATSAPP_NUMBER=919876543210
SUPPORT_PHONE=+91 98765 43210
SUPPORT_EMAIL=hello@greenpulse.in

# ── 7. Environment Mode ────────────────────────────────────────────────────────
# Set to 'production' on Render / Railway.
ENVIRONMENT=development
# Set to '1' during automated CI test runs to bypass remote DB connect loops.
TESTING=0
